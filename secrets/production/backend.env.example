PORT=8081
NODE_ENV=production
DATABASE_URL=postgresql://booking_user:replace_with_strong_production_password@vietsage-postgres:5432/booking_db?schema=public
CORS_ORIGINS=https://booking.vietsage.com

JWT_SECRET=replace_with_64_character_random_hex_string_for_jwt_access

VIETSAGE_API_BASE_URL=http://vietsage-auth-service:8080
VIETSAGE_HMAC_SECRET=replace_with_shared_hmac_secret_minimum_32_characters

STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_CHECKOUT_RETURN_BASE_URL=https://booking.vietsage.com
STRIPE_SIMULATED=false
